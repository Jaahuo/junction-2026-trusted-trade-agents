# Copy to .env (ignored by git). Bun loads .env automatically.
# Read values in code with env("NAME") from @app/server-kit, inside infra/ or api/.
# Local runtime settings are generated in .env.local by bun scripts/runtime.ts setup.
# Do not put database URLs or worktree ports in this secrets file.

# Claude API key for the notes summary. Leave empty to run without it.
ANTHROPIC_API_KEY=

# Valio Aimo challenge access. Obtain credentials from the organizers.
VALIO_AIMO_API_KEY=
VALIO_AIMO_PORTAL_PASSWORD=

# Wholesaler mock base URL. Only the wholesaler adapters read it.
VALIO_AIMO_BASE_URL=

# Offer and mandate signing keys (SPEC-006, SPEC-008). Create them with: bun scripts/generate-keys.ts
# Without offer keys, a non-production server makes a key per process, so a restart invalidates offers.
OFFER_SIGNING_JWK=
OFFER_SIGNING_KID=
BUYER_SIGNING_JWK=

# Base URLs (SPEC-001). PUBLIC_BASE_URL is the URL that hosts and browsers see, for example a tunnel.
# Both default to http://127.0.0.1:$PORT.
PUBLIC_BASE_URL=
INTERNAL_BASE_URL=

# Wholesaler adapters (SPEC-005): WHOLESALER_LIVE=mock|fixture|json, WHOLESALER_CATALOG=file|json.
WHOLESALER_LIVE=
WHOLESALER_CATALOG=

# MCP view tools (SPEC-012): app (default) or off.
MCP_VIEW_TOOLS=
