{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreUnresolved": ["scripts/.+\\.ts", "apps/api/src/(main|remote-reset)\\.ts"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", ".omp/hooks/*/*.ts"],
      "ignoreDependencies": ["@app/contract"]
    },
    "apps/api": {
      "entry": ["src/main.ts!", "src/server.ts!"]
    },
    "contexts/offers": {
      "ignoreDependencies": [
        "@app/kernel",
        "@ctx/catalog",
        "@ctx/mandates",
        "@ctx/orders",
        "@elysia/eden",
        "zod"
      ]
    },
    "contexts/orders": {
      "ignoreDependencies": ["react", "@tanstack/react-query", "zod"]
    },
    "contexts/views": {
      "entry": ["src/views/*/main.{ts,tsx}"],
      "ignoreDependencies": ["@ctx/mandates", "@ctx/orders", "@elysia/eden"]
    },
    "contexts/mandates": {
      "ignoreDependencies": ["zod"]
    }
  },
  "ignoreBinaries": ["gitleaks", "tofu"]
}
