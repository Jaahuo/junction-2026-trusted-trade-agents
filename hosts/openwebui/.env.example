# Copy to hosts/openwebui/.env (ignored by git). Only bun scripts/openwebui.ts and its Compose file read it.

# Port of Open WebUI on this machine.
OPENWEBUI_PORT=38090

# Session secret. Keep it stable, or MCP Apps views stop working after a restart. Create one with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# OpenAI-compatible model endpoint, as the container sees it. Setup pushes these to Open WebUI on every run,
# because Open WebUI otherwise keeps the endpoint from its first start.
# Hosted: https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1 with the Verda inference key,
# and OPENWEBUI_BASE_MODEL=nemotron-3.5-super-vl.
OPENAI_API_BASE_URL=http://host.docker.internal:18080/v1
OPENAI_API_KEY=

# Base model of the "Buyer agent" model. Empty = the first model of the endpoint that is not an embedding model.
OPENWEBUI_BASE_MODEL=

# MCP server URL, as the container sees it. Empty = this worktree's API: http://host.docker.internal:<PORT>/mcp
OPENWEBUI_MCP_URL=

# Optional speech output (docs/sponsors.md). Leave empty for text only.
AUDIO_TTS_ENGINE=
AUDIO_TTS_API_KEY=
AUDIO_TTS_MODEL=
AUDIO_TTS_VOICE=
