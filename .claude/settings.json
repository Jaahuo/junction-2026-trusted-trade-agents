  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "cat AGENTS.md" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "cat AGENTS.md" }] }],
    "Stop": [
      {
        "hooks": [
          {
