{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "cat AGENTS.md" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "cat AGENTS.md" }] }],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/claude-stop.ts\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(bun check)",
      "Bash(bunx vp check)",
      "Bash(gh project list *)",
      "Bash(gh project item-list *)",
      "Bash(gh project view *)"
    ]
  }
}
