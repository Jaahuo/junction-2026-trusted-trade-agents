{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreUnresolved": ["scripts/.+\\.ts", "apps/api/src/main\\.ts"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", ".omp/hooks/*/*.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts!", "src/server.ts!"]
    },
    "contexts/offers": {
      "ignoreDependencies": [
        "@app/kernel",
        "@ctx/catalog",
        "@ctx/mandates",
        "@ctx/orders",
        "@elysia/eden",
        "zod"
      ]
    },
    "contexts/orders": {
      "ignoreDependencies": [
        "react",
        "@app/kernel",
        "@ctx/mandates",
        "@elysia/eden",
        "@tanstack/react-query",
        "drizzle-orm",
        "zod"
      ]
    },
    "contexts/views": {
      "entry": ["src/views/*/main.{ts,tsx}"],
      "ignoreDependencies": ["@ctx/mandates", "@ctx/orders", "@elysia/eden"]
    },
    "contexts/mandates": {
      "ignoreDependencies": ["zod"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
