# Copy to hosts/openwebui/.env (ignored by git). Only bun scripts/openwebui.ts and its Compose file read it.

# Port of Open WebUI on this machine.
OPENWEBUI_PORT=38090

# Stable session secret: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Local operator. Existing accounts keep their stored password.
WEBUI_ADMIN_EMAIL=operator@localhost.invalid
WEBUI_ADMIN_PASSWORD=

# Verda's exact Nemotron 3.5 Super VL endpoint and provider model ID.
OPENAI_API_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
OPENAI_API_KEY=
OPENWEBUI_BASE_MODEL=nemotron-3.5-super-vl
OPENWEBUI_MAX_TOKENS=4096

# MCP server URL, as the container sees it. Empty = this worktree's API: http://host.docker.internal:<PORT>/mcp
OPENWEBUI_MCP_URL=

# Recipe fetching stays off until usage permission is confirmed. Arithmetic remains available.
VALIO_AIMO_RECIPE_PERMISSION=False

# Optional purchasing credential, separate from inference and human approval credentials.
MCP_AGENT_KEY=

# Optional speech output (docs/sponsors.md). Leave empty for text only.
AUDIO_TTS_ENGINE=
AUDIO_TTS_API_KEY=
AUDIO_TTS_MODEL=
AUDIO_TTS_VOICE=
