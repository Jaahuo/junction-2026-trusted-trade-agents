{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreUnresolved": ["scripts/.+\\.ts", "apps/api/src/main\\.ts"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", ".omp/hooks/*/*.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts!", "src/server.ts!"]
    },
    "contexts/catalog": {
      "ignoreDependencies": ["@app/kernel", "@ctx/mandates", "@elysia/eden", "zod"]
    },
    "contexts/mandates": {
      "ignoreDependencies": ["@app/kernel", "drizzle-orm", "zod"]
    },
    "contexts/mcp": {
      "ignoreDependencies": [
        "@app/contract",
        "@app/kernel",
        "@ctx/catalog",
        "@ctx/mandates",
        "@ctx/offers",
        "@ctx/orders",
        "@elysia/eden",
        "@modelcontextprotocol/ext-apps",
        "@modelcontextprotocol/sdk",
        "zod"
      ]
    },
    "contexts/offers": {
      "ignoreDependencies": [
        "@app/kernel",
        "@ctx/catalog",
        "@ctx/mandates",
        "@ctx/orders",
        "@elysia/eden",
        "zod"
      ]
    },
    "contexts/orders": {
      "ignoreDependencies": [
        "react",
        "@app/kernel",
        "@ctx/mandates",
        "@elysia/eden",
        "@tanstack/react-query",
        "drizzle-orm",
        "zod"
      ]
    },
    "contexts/views": {
      "entry": ["src/views/*/main.tsx", "src/harness/main.tsx"],
      "ignoreDependencies": [
        "@app/contract",
        "@ctx/mandates",
        "@ctx/orders",
        "@elysia/eden",
        "@modelcontextprotocol/ext-apps"
      ]
    },
    "packages/contract": {
      "ignoreDependencies": ["jose"]
    },
    "contexts/*": {
      "ignoreDependencies": ["react"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
