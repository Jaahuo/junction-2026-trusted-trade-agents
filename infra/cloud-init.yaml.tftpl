#cloud-config
package_update: true
packages:
  - caddy
  - rsync
  - unzip
users:
  - default
  - name: app
    system: true
    shell: /usr/sbin/nologin
write_files:
  - path: /etc/systemd/system/trusted-trade.service
    content: |
      [Unit]
      Description=Trusted trade agents API
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=/etc/trusted-trade.env

      [Service]
      User=app
      WorkingDirectory=${app_dir}
      EnvironmentFile=/etc/trusted-trade.env
      ExecStart=/usr/local/bin/bun apps/api/src/main.ts
      Restart=on-failure
      RestartSec=2

      [Install]
      WantedBy=multi-user.target
%{ if ci_ssh_public_key != "" ~}
  - path: /root/.ssh/authorized_keys
    append: true
    permissions: "0600"
    content: |
      ${ci_ssh_public_key}
%{ endif ~}
runcmd:
  - curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash -s "bun-v${bun_version}"
  - mkdir -p ${app_dir}
  - chown app:app ${app_dir}
  - systemctl daemon-reload
  - systemctl enable trusted-trade.service
